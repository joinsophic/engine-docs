{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "mint",
	"name": "Sophic Engine",
	"fonts": {
		"family": "Geist"
	},
	"colors": {
		"primary": "#2A3141",
		"light": "#E6EDF3",
		"dark": "#FF0000"
	},
	"styling": {
		"eyebrows": "section",
		"codeblocks": {
			"theme": "catppuccin-mocha"
		}
	},
	"contextual": {
		"options": ["view", "copy", "chatgpt", "claude"]
	},
	"appearance": {
		"default": "light",
		"strict": true
	},
	"background": {
		"color": {
			"light": "#ffffff"
		}
	},
	"favicon": "/favicon.svg",
	"api": {
		"openapi": "openapi.json"
	},
	"navigation": {
		"tabs": [
			{
				"tab": "Documentation",
				"icon": "book-open",
				"groups": [
					{
						"group": "Getting Started",
						"pages": ["docs/intro", "docs/environments"]
					},
					{
						"group": "Onboarding",
						"pages": [
							"docs/onboarding/overview",
							"docs/onboarding/persons",
							"docs/onboarding/claims",
							"docs/onboarding/applications",
							"docs/onboarding/errors"
						]
					},
					{
						"group": "Orders",
						"pages": [
							"docs/orders/overview",
							"docs/orders/testing",
							"docs/orders/lifecycle",
							"docs/orders/rollovers",
							"docs/orders/errors",
							"docs/orders/best-practices"
						]
					},
					{
						"group": "Webhooks",
						"pages": [
							"docs/webhooks/overview",
							"docs/webhooks/verifying-signatures",
							"docs/webhooks/deliveries",
							"docs/webhooks/events",
							"docs/webhooks/best-practices"
						]
					}
				]
			},
			{
				"tab": "API Reference",
				"icon": "square-terminal",
				"groups": [
					{
						"group": "Topics",
						"pages": [
							"api-reference/auth",
							"api-reference/data-formats",
							"api-reference/idempotency",
							"api-reference/errors",
							"api-reference/versioning",
							"api-reference/best-practices"
						]
					},
					{
						"group": "Endpoints",
						"openapi": "openapi.json"
					}
				]
			},
			{
				"tab": "Changelog",
				"icon": "clock-rotate-left",
				"pages": ["changelog"]
			}
		]
	},
	"logo": {
		"light": "https://cdn.usesophic.com/logo-black.svg",
		"dark": "https://cdn.usesophic.com/logo-white.svg"
	},
	"navbar": {
		"links": [{ "label": "Support", "href": "mailto:hello@usesophic.com" }]
	},
	"redirects": [
		{
			"source": "/",
			"destination": "/docs/intro"
		}
	],
	"footer": {
		"socials": {
			"github": "https://github.com/athloscap",
			"linkedin": "https://www.linkedin.com/company/sophicwealth/"
		}
	}
}
